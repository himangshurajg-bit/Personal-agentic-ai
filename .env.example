# Optional adapters. The CLI does not load this file; service.app reads its own variables.
# Set secrets only in the private service process environment. Never commit real keys.
LOCAL_AGENT_URL=http://127.0.0.1:11434
LOCAL_AGENT_MODEL=
OPENAI_API_KEY=
CLOUD_AGENT_MODEL=
# Optional hosted mobile-service provider; default stays local Ollama with no fallback.
ASSISTANT_PROVIDER=ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# AGENT_DB=.agent-data/memory.sqlite3
